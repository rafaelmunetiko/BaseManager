        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var CheckDuplicateBase = Class.create();
CheckDuplicateBase.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {


    checkDuplicateName: function() {
        var name = this.getParameter('sysparm_name_value');
        var sysId = this.getParameter('sysparm_sys_id');

        if (!name) return 'OK';

        var gr = new GlideRecord('x_752538_base_ma_0_bases');
        gr.addQuery('name', name);
        if (sysId) gr.addQuery('sys_id', '!=', sysId);
        gr.setLimit(1);
        gr.query();

        return gr.next() ? 'DUPLICATE_NAME' : 'OK';
    },

    checkDuplicateLocation: function() {
        var city = this.getParameter('sysparm_city');
        var state = this.getParameter('sysparm_state');
        var sysId = this.getParameter('sysparm_sys_id');

        if (!city || !state) return 'OK';

        var gr = new GlideRecord('x_752538_base_ma_0_bases');
        gr.addQuery('city', city);
        gr.addQuery('state', state);
        if (sysId) gr.addQuery('sys_id', '!=', sysId);
        gr.setLimit(1);
        gr.query();

        return gr.next() ? 'DUPLICATE_CITY_STATE' : 'OK';
    }

});
]]></script>
