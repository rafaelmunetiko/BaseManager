        <script><![CDATA[var CheckBaseCapacity = Class.create();
CheckBaseCapacity.prototype = {
    initialize: function() {},

    checkIfBaseIsFullById: function(baseId) {
        if (!baseId) return false;
        var baseGR = new GlideRecord('x_752538_base_ma_0_bases');
        if (!baseGR.get(baseId)) return false;
        return baseGR.getValue('capacity_status') == '3';
    },

    checkIfBaseIsFull: function() {

        var baseId = this.getParameter('sysparm_base_id');
        return this.checkIfBaseIsFullById(baseId);
    },

    type: 'CheckBaseCapacity'
};
]]></script>
