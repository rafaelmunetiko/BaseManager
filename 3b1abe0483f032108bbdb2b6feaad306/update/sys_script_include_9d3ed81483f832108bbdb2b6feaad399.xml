    hasActiveRegistration: function() {

        var userId = gs.getUserID();
        if (!userId) return false;

        var gr = new GlideRecord('x_752538_base_ma_0_memberships');
        gr.addQuery('opened_by', userId);   
        gr.addQuery('state', 'NOT IN', '4');  
        gr.query();

        return gr.hasNext(); 
    },

    type: 'CheckExistingBaseRegistration'
});
]]></script>
