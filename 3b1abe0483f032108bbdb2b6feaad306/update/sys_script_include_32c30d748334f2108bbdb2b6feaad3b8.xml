        <script><![CDATA[var BaseManagerFilter = Class.create();
BaseManagerFilter.prototype = {
    initialize: function() {
    },

    getAvailableManagers: function() {
        var managers = [];
        
        var gr = new GlideRecord('x_752538_base_ma_0_bases'); 
        gr.addNotNullQuery('manager');
        gr.query();

        while(gr.next()) {

            managers.push(gr.getValue('manager'));
        }
        
        if (managers.length == 0) {
            return 'roles=x_752538_base_ma_0.manager';
        }
        
        return 'roles=x_752538_base_ma_0.manager^sys_idNOT IN' + managers.join(',');
    },

    type: 'BaseManagerFilter'
};]]></script>
