        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || newValue == '')
        return;


    var ga = new GlideAjax('CheckExistingBaseRegistration');
    ga.addParam('sysparm_name', 'hasActiveRegistration'); 
    ga.getXMLAnswer(function(answer) {
        if (answer == 'true') {
            g_form.clearValue('base');
            g_form.clearValue('function');
            g_form.showFieldMsg('base', 'You already have a registration in another base. If you already sent a request, please wait for approval or rejection.', 'error');
        } else {

            g_form.hideFieldMsg('base');
        }
    });
}]]></script>
